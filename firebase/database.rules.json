{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "towns": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$town": {
        ".validate": "$town.matches(/^[a-z0-9-]{1,40}$/) && newData.hasChildren(['name', 'lat', 'lon', 'km'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lon": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "km": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100" },
        "order": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "catalog": {
      ".read": true,
      ".indexOn": ["townId"],
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$biz": {
        ".validate": "$biz.matches(/^[a-z0-9-]{1,40}$/) && newData.hasChildren(['name', 'fee', 'townId'])",
        "townId": { ".validate": "newData.isString() && root.child('towns').child(newData.val()).exists()" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "fee": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "open": { ".validate": "newData.isBoolean()" },
        "panel": { ".validate": "newData.isBoolean()" },
        "mp": { ".validate": "newData.isBoolean()" },
        "menu": {
          "$item": {
            ".validate": "$item.matches(/^[a-z0-9-]{1,40}$/) && newData.hasChildren(['name', 'price'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
            "price": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000" },
            "available": { ".validate": "newData.isBoolean()" }
          }
        }
      }
    },

    "customers": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
        "phone": { ".validate": "newData.isString() && newData.val().matches(/^[0-9 +()-]{0,20}$/)" },
        "$other": { ".validate": false }
      }
    },

    "userOrders": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["status"],
      "$id": {
        ".read": "auth != null && (data.child('customerUid').val() === auth.uid || data.child('driver/uid').val() === auth.uid)"
      }
    },

    "bizUsers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "bizStaff": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "bizOrders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$biz": { ".read": "auth != null && root.child('bizUsers').child(auth.uid).val() === $biz" }
    },

    "openOrders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$town": {
        ".read": "auth != null && root.child('drivers').child(auth.uid).child('status').val() === 'aprobado' && root.child('drivers').child(auth.uid).child('townId').val() === $town"
      }
    },

    "online": {
      "$town": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('drivers').child($uid).child('status').val() === 'aprobado' && root.child('drivers').child($uid).child('townId').val() === $town && root.child('drivers').child($uid).child('licenciaVence').val() > now))",
          ".validate": "newData.val() === true"
        }
      }
    },

    "presence": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && root.child('drivers').child($uid).child('status').val() === 'aprobado' && root.child('drivers').child($uid).child('licenciaVence').val() > now",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "drivers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["townId"],
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "driverActive": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "settlements": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "payouts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "padron": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$dni": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && (!data.child('uid').exists() || (newData.exists() && newData.child('uid').val() === data.child('uid').val()))",
        ".validate": "$dni.matches(/^[0-9]{7,8}$/) && newData.hasChildren(['nombre', 'apellido', 'nacimiento', 'licenciaVence', 'townId'])",
        "townId": { ".validate": "newData.isString() && root.child('towns').child(newData.val()).exists()" },
        "nombre": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "apellido": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "nacimiento": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "telefono": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "vehiculo": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "patente": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "licenciaVence": { ".validate": "newData.isNumber()" },
        "activo": { ".validate": "newData.isBoolean()" },
        "uid": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    }
  }
}
